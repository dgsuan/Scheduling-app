# Copy this file to .env.local (already git-ignored) and fill in the values
# from Supabase → Project Settings → API.
#
# The publishable key is safe to ship in the website. NEVER put the
# service_role / secret key here — it bypasses all security rules.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: background reminders. The PUBLIC half of your VAPID key pair
# (see supabase/README.md). The private half only goes in Supabase secrets.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
