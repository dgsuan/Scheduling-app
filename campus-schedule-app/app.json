{
  "expo": {
    "name": "Campus Schedule",
    "slug": "campus-schedule-app",
    "scheme": "campusschedule",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davesuan.campusschedule"
    },
    "android": {
      "package": "com.davesuan.campusschedule",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add images to the notes canvas."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "632de947-891d-45d6-84de-ec04273289b3"
      }
    },
    "owner": "dadave123"
  }
}
