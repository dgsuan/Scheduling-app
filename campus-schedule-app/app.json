{
  "expo": {
    "name": "Isked",
    "slug": "campus-schedule-app",
    "scheme": "campusschedule",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davesuan.campusschedule"
    },
    "android": {
      "package": "com.davesuan.campusschedule",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#28716A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to add images to the notes canvas."
        }
      ],
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "IskedHabits",
              "label": "Isked habits",
              "description": "Today’s habits and progress. Tap a habit to check in.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/Scheduling-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "632de947-891d-45d6-84de-ec04273289b3"
      }
    },
    "owner": "dadave123"
  }
}
